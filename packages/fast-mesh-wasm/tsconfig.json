{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom", "esnext.disposable"],
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedDeclarations": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test"]
}
