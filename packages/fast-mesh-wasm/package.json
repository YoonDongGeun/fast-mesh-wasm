{
  "name": "fast-mesh-wasm",
  "version": "0.2.0",
  "description": "Fast triangle mesh utilities for JavaScript, written in Rust and compiled to WebAssembly",
  "keywords": [
    "mesh",
    "geometry",
    "normals",
    "bounding-box",
    "webassembly",
    "wasm",
    "rust",
    "threejs"
  ],
  "homepage": "https://github.com/YoonDongGeun/fast-mesh-wasm#readme",
  "bugs": "https://github.com/YoonDongGeun/fast-mesh-wasm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoonDongGeun/fast-mesh-wasm.git",
    "directory": "packages/fast-mesh-wasm"
  },
  "license": "MIT OR Apache-2.0",
  "author": "DongGeun Yoon",
  "type": "module",
  "sideEffects": [
    "./dist/node.js"
  ],
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "default": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/web.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node ../../scripts/build-wasm.mjs --test && tsdown && vitest run",
    "prepublishOnly": "node -e \"if (require('fs').readFileSync('dist/wasm/fast_mesh_wasm.d.ts', 'utf8').includes('__test_panic')) { console.error('dist/ is a test build (it exports __test_panic): run pnpm build first'); process.exit(1); }\"",
    "bench": "node bench/scene.bench.mjs",
    "check": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
